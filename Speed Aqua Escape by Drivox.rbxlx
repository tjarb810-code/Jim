	end

	p1.CharacterAdded:Connect(function(p1) --[[ Line: 94 | Upvalues: watchCharacter (ref) ]]
		task.spawn(watchCharacter, p1)
	end)
end

for i, v in ipairs(Players:GetPlayers()) do
	task.spawn(watchPlayer, v)
end

Players.PlayerAdded:Connect(watchPlayer)
