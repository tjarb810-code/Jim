local function setupWinsHUD() --[[ setupWinsHUD | Line: 21 | Upvalues: HUD (copy), LocalPlayer (copy), NumberFormatter (copy), MonetizationSystem (copy), ProductConfigurations (copy) ]]
	local Wins = HUD:WaitForChild("Left"):WaitForChild("Wins")
