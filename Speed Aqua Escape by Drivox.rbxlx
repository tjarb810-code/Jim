				task.delay(0.15, function() --[[ Line: 64 | Upvalues: Sounds (ref) ]]
					pcall(function() --[[ Line: 64 | Upvalues: Sounds (ref) ]]
						Sounds:FindFirstChild("Click"):Play()
					end)
				end)
				FrameManager.open("FreeReward", true)
			end
		end)
	end

	local Gift = HUD:FindFirstChild("Gift")

	if Gift and Frames:FindFirstChild("GiftTreadmill") then
		FrameManager.connect(Gift, "GiftTreadmill", "Toggle")
	end

	local Rebirth2 = Left:FindFirstChild("Rebirth")
	local v2 = if Rebirth2 then Rebirth2:FindFirstChild("Settings") else Rebirth2

	if v2 and Frames:FindFirstChild("Settings") then
		FrameManager.connect(v2, "Settings", "Toggle")
