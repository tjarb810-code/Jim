local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local function startPulse(p1) --[[ startPulse | Line: 14 | Upvalues: RunService (copy) ]]
	local Frame = p1:FindFirstChildOfClass("Frame")

	if not Frame then
		return
	end

	local Text = Frame:FindFirstChild("Text")
	local v1 = p1:GetAttribute("PulseColor") or Color3.fromRGB(255, 60, 60)
	local v2 = v1:Lerp(Color3.new(0/255, 0/255, 0/255), 0.15)
	local v3 = v1:Lerp(Color3.new(255/255, 255/255, 255/255), 0.5)
	local v4

	if Text then
		v4 = Instance.new("UIGradient")
		v4.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, v2),
			ColorSequenceKeypoint.new(0.3, v2),
			ColorSequenceKeypoint.new(0.45, v3),
			ColorSequenceKeypoint.new(0.55, v3),
			ColorSequenceKeypoint.new(0.7, v2),
			ColorSequenceKeypoint.new(1, v2)
		})
		v4.Rotation = 0
		v4.Parent = Text
	else
		v4 = nil
	end

	local v5 = tick()
	local v6 = nil

	v6 = RunService.RenderStepped:Connect(function() --[[ Line: 44 | Upvalues: p1 (copy), v6 (ref), v5 (copy), v4 (ref), v1 (ref), v2 (copy) ]]
		if not p1.Parent then
			v6:Disconnect()

			return
		end

		local v12 = tick() - v5
		local v22 = 1.5 - v12 * 0.6 % 1 * 3

		if v4 and v4.Parent then
			v4.Offset = Vector2.new(v22, 0)
		end

		v1:Lerp(v2, 1 - (math.sin(v12 * 1.4 * math.pi) + 1) / 2)
	end)
end

local function onChild(p1) --[[ onChild | Line: 65 | Upvalues: startPulse (copy) ]]
	if p1.Name ~= "RankTag" or not p1:IsA("BillboardGui") then
		return
	end

	if p1:GetAttribute("PulseColor") then
		task.spawn(startPulse, p1)
	else
		p1:GetAttributeChangedSignal("PulseColor"):Once(function() --[[ Line: 70 | Upvalues: startPulse (ref), p1 (copy) ]]
			task.spawn(startPulse, p1)
		end)
	end
end

local function watchHead(p1) --[[ watchHead | Line: 76 | Upvalues: onChild (copy) ]]
	for i, v in ipairs(p1:GetChildren()) do
		onChild(v)
	end

	p1.ChildAdded:Connect(onChild)
end

local function watchCharacter(p1) --[[ watchCharacter | Line: 83 | Upvalues: watchHead (copy) ]]
	local Head = p1:WaitForChild("Head", 8)

	if not (Head and Head:IsA("BasePart")) then
		return
	end

