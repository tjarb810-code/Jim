	end

	local function updateDisplay() --[[ updateDisplay | Line: 102 | Upvalues: LocalPlayer (ref), MaxSpeed (copy), NumberFormatter (ref), v1 (ref), EnterSpeed (copy) ]]
		local leaderstats = LocalPlayer:FindFirstChild("leaderstats")

		if not leaderstats then
			return
		end

		local v12 = (leaderstats:FindFirstChild("Level").Value - 1) * 2 + 8

		MaxSpeed.Text = "MAX: " .. NumberFormatter.Format(v12)

		if not v1 then
			return
		end

		EnterSpeed.Text = tostring(v12)

		local Character = LocalPlayer.Character

		if not Character then
			return
		end

		Character:SetAttribute("SwimSpeed", v12)

		local Humanoid = Character:FindFirstChildOfClass("Humanoid")

