		if not Humanoid then
			return
		end

		Humanoid.WalkSpeed = v2
	end)

	local leaderstats = LocalPlayer:WaitForChild("leaderstats", 10)

	if not leaderstats then
		return
	end

	leaderstats:WaitForChild("Level").Changed:Connect(updateDisplay)
	updateDisplay()
end

