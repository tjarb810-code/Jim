-- https://lua.expert/
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PlusOneModule = require(script.Parent.PlusOneModule)
local LocalPlayer = Players.LocalPlayer
local v1 = 0

RunService.Heartbeat:Connect(function() --[[ Line: 24 | Upvalues: LocalPlayer (copy), v1 (ref), PlusOneModule (copy) ]]
	local Character = LocalPlayer.Character

	if not Character then
		return
	end

	local Humanoid = Character:FindFirstChild("Humanoid")

	if not Humanoid or Humanoid.Health <= 0 then
		return
	end

	if Humanoid.MoveDirection.Magnitude > 0 then
		local v12 = os.clock()

		if 0.6 - math.clamp((Humanoid.WalkSpeed - 16) / 484, 0, 1) * 0.5 <= v12 - v1 then
			PlusOneModule.ShowPlusOne(1, 1, 1, 1, 1, 1)
			v1 = v12
		end
	else
		v1 = 0
	end
end)]]></ProtectedString><BinaryString name="AttributesSerialize">AQAAABEAAABfbGVtb25hZGVVbmlxdWVJZAIMAAAAQmZQeW9LZUVCZlB5</BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[PlusOneLocalScript]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties></Item></Item><Item class="Model" referent="2562"><Properties><CoordinateFrame name="ModelMeshCFrame"><X>-72.45245361328125</X><Y>-5.024074554443359</Y><Z>-1223.3648681640625</Z><R00>-1.1920928955078125e-07</R00><R01>0</R01><R02>1.0000001192092896</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-1.0000001192092896</R20><R21>0</R21><R22>-1.1920928955078125e-07</R22></CoordinateFrame><Vector3 name="ModelMeshSize"><X>0</X><Y>0</Y><Z>0</Z></Vector3><bool name="NeedsPivotMigration">false</bool><float name="ScaleFactor">0.24367006123065948</float><OptionalCoordinateFrame name="WorldPivotData"><CFrame><X>-1618.6885986328125</X><Y>2.5687828063964844</Y><Z>-1597.5828857421875</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CFrame></OptionalCoordinateFrame><BinaryString name="AttributesSerialize">AQAAABEAAABfbGVtb25hZGVVbmlxdWVJZAIMAAAANXdwWDRNdW01d3BY</BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[Standartsskill266643]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties><Item class="BodyColors" referent="2563"><Properties><Color3 name="HeadColor3"><R>0.6666666865348816</R><G>0.5411764979362488</G><B>0.3843137323856354</B></Color3><Color3 name="LeftArmColor3"><R>0.6666666865348816</R><G>0.5411764979362488</G><B>0.3843137323856354</B></Color3><Color3 name="LeftLegColor3"><R>0.6666666865348816</R><G>0.5411764979362488</G><B>0.3843137323856354</B></Color3><Color3 name="RightArmColor3"><R>0.6666666865348816</R><G>0.5411764979362488</G><B>0.3843137323856354</B></Color3><Color3 name="RightLegColor3"><R>0.6666666865348816</R><G>0.54