	local More = Wins:WaitForChild("More")

	local function updateWinsText() --[[ updateWinsText | Line: 27 | Upvalues: LocalPlayer (ref), Text (copy), NumberFormatter (ref) ]]
		local leaderstats = LocalPlayer:FindFirstChild("leaderstats")

		if not leaderstats then
			return
		end

		local Wins = leaderstats:FindFirstChild("Wins")

		if not Wins then
			return
		end

		Text.Text = NumberFormatter.Format(Wins.Value)
	end

	More.MouseButton1Click:Connect(function() --[[ Line: 37 | Upvalues: MonetizationSystem (ref), ProductConfigurations (ref) ]]
		MonetizationSystem.PromptGamePass(ProductConfigurations.DoubleWinsGP)
	end)

	local leaderstats = LocalPlayer:WaitForChild("leaderstats", 10)

	if not leaderstats then
		return
	end

	leaderstats:WaitForChild("Wins").Changed:Connect(updateWinsText)

	local leaderstats2 = LocalPlayer:FindFirstChild("leaderstats")

	if not leaderstats2 then
		return
	end

	local Wins2 = leaderstats2:FindFirstChild("Wins")

	if not Wins2 then
		return
	end

	Text.Text = NumberFormatter.Format(Wins2.Value)
end

local function setupSpeedShopHUD() --[[ setupSpeedShopHUD | Line: 50 | Upvalues: HUD (copy), ProductConfigurations (copy), NumberFormatter (copy), MonetizationSystem (copy) ]]
	local Speed = HUD:WaitForChild("Bottom"):WaitForChild("Speed")
