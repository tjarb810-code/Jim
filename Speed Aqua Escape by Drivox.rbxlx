		FrameManager.connect(Rebirth, "Rebirth", "Toggle")
	end

	local Trails = Left:FindFirstChild("Trails")

	if Trails and Frames:FindFirstChild("Trails") then
		FrameManager.connect(Trails, "Trails", "Toggle")
	end

	local Cars = Left:FindFirstChild("Cars")

	if Cars and Frames:FindFirstChild("Cars") then
		FrameManager.connect(Cars, "Cars", "Toggle")
	end

	local Teleport = Left:FindFirstChild("Teleport")

	if Teleport and Frames:FindFirstChild("Teleport") then
		FrameManager.connect(Teleport, "Teleport", "Toggle")
	end

	local Trails2 = Left:FindFirstChild("Trails")
	local v1 = if Trails2 then Trails2:FindFirstChild("Free") else Trails2

	if v1 and Frames:FindFirstChild("FreeReward") then
		local Sounds = game:GetService("Workspace"):WaitForChild("Sounds")

		v1.MouseButton1Click:Connect(function() --[[ Line: 59 | Upvalues: FrameManager (ref), Sounds (copy) ]]
			if FrameManager.isOpen("FreeReward") then
				FrameManager.close("FreeReward")
