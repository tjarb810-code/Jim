	if not SpeedProducts then
		return
	end

	for i, v in ipairs(SpeedProducts) do
		local v1 = Speed:FindFirstChild("Product" .. tostring(i))

		if v1 then
			local Text = v1:FindFirstChild("Text")

			if Text then
				Text.Text = "+" .. NumberFormatter.Format(v.Amount) .. " Speed"
			end

			v1.MouseButton1Click:Connect(function() --[[ Line: 67 | Upvalues: MonetizationSystem (ref), v (copy) ]]
				MonetizationSystem.PromptProduct(v.Id)
			end)
		end
	end
end

