"Anchored"><bool>true</bool></Property><Property name="CanCollide"><bool>true</bool></Property><Property name="CFrame"><CoordinateFrame>7, 4, 100, 1, 0, 0, 0, 1, 0, 0, 0, 1</CoordinateFrame></Property><Property name="Size"><Vector3>2, 8, 1</Vector3></Property><Property name="BrickColor"><int>100</int></Property><Property name="Material"><token>256</token></Property><Property name="Transparency"><float>0</float></Property><Property name="TopSurface"><token>0</token></Property><Property name="BottomSurface"><token>0</token></Property></Properties></Item><Item class_name="Part" referent="RBX5CF34FD45BF0"><Properties><Property name="Name"><string>KeySpawn_6</string></Property><Property name="Anchored"><bool>true</bool></Property><Property name="CanCollide"><bool>false</bool></Property><Property name="CFrame"><CoordinateFrame>11.9, 1.5, 107, 1, 0, 0, 0, 1, 0, 0, 0, 1</CoordinateFrame></Property><Property name="Size"><Vector3>1, 1, 1</Vector3></Property><Property name="BrickColor"><int>1</int></Property><Property name="Material"><token>256</token></Property><Property name="Transparency"><float>0.15</float></Property><Property name="TopSurface"><token>0</token></Property><Property name="BottomSurface"><token>0</token></Property></Properties></Item><Item class_name="Part" referent="RBX3F21C6065157"><Properties><Property name="Name"><string>PuzzleRoomFloor</string></Property><Property name="Anchored"><bool>true</bool></Property><Property name="CanCollide"><bool>true</bool></Property><Property name="CFrame"><CoordinateFrame>0, 0, 175, 1, 0, 0, 0, 1, 0, 0, 0, 1</CoordinateFrame></Property><Property name="Size"><Vector3>44, 1, 36</Vector3></Property><Property name="BrickColor"><int>100</int></Property><Property name="Material"><token>256</token></Property><Property name="Transparency"><float>0</float></Property><Property name="TopSurface"><token>0</token></Property><Property name="BottomSurface"><token>0</token></Property></Properties></Item><Item class_name="Part" referent="RBXBBD428A96828"><Properties><Property name="Name"><string>PuzzleRune_1</string></Property><Property name="Anchored"><bool>true</bool></Property><Property name="CanCollide"><bool>true</bool></Property><Property name="CFrame"><CoordinateFrame>-12, 1, 170, 1, 0, 0, 0, 1, 0, 0, 0, 1</CoordinateFrame></Property><Property name="Size"><Vector3>3, 0.3, 3</Vector3></Property><Property name="BrickColor"><int>21</int></Property><Property name="Material"><token>256</token></Property><Property name="Transparency"><float>0</float></Property><Property name="TopSurface"><token>0</token></Property><Property name="BottomSurface"><token>0</token></Property></Properties></Item><Item class_name="Part" referent="RBX0AB0C7647400"><Properties><Property name="Name"><string>PuzzleRune_2</string></Property><Property name="Anchored"><bool>true</bool></Property><Property name="CanCollide"><bool>true</bool></Property><Property name="CFrame"><CoordinateFrame>-4, 1, 170, 1, 0, 0, 0, 1, 0, 0, 0, 1</CoordinateFrame></Property><Property name="Size"><Vector3>3, 0.3, 3</Vector3></Property><Property name="BrickColor"><int>23</int></Property><Property name="Material"><token>256</token></Property><Property name="Transparency"><float>0</float></Property><Property name="TopSurface"><token>0</token></Property><Property name="BottomSurface"><token>0</token></Property></Properties></Item><Item class_name="Part" referent="RBXFB77AEB66994"><Properties><Property name="Name"><string>PuzzleRune_3</string></Property><Property name="Anchored"><bool>true</bool></Property><Property name="CanCollide"><bool>true</bool></Property><Property name="CFrame"><CoordinateFrame>4, 1, 170, 1, 0, 0, 0, 1, 0, 0, 0, 1</CoordinateFrame></Property><Property name="Size"><Vector3>3, 0.3, 3</Vector3></Property><Property name="BrickColor"><int>24</int></Property><Property name="Material"><token>256</token></Property><Property name="Transparency"><float>0</float></Property><Property name="TopSurface"><token>0</token></Property><Property name="BottomSurface"><token>0</token></Property></Properties></Item><Item class_name="Part" referent="RBXDBA808070771"><Properties><Property name="Name"><string>PuzzleRune_4</string></Property><Property name="Anchored"><bool>true</bool></Property><Property name="CanCollide"><bool>true</bool></Property><Property name="CFrame"><CoordinateFrame>12, 1, 170, 1, 0, 0, 0, 1, 0, 0, 0, 1</CoordinateFrame></Property><Property name="Size"><Vector3>3, 0.3, 3</Vector3></Property><Property name="BrickColor"><int>100</int></Property><Property name="Material"><token>256</token></Property><Property name="Transparency"><float>0</float></Property><Property name="TopSurface"><token>0</token></Property><Property name="BottomSurface"><token>0</token></Property></Properties></Item><Item class_name="SpawnLocation" referent="RBX5F43CA218E64"><Properties><Property name="Name"><string>PlayerSpawn</string></Property><Property name="Anchored"><bool>true</bool></Property><Property name="CanCollide"><bool>true</bool></Property><Property name="CFrame"><CoordinateFrame>0, 2, -230, 1, 0, 0, 0, 1, 0, 0, 0, 1</CoordinateFrame></Property><Property name="Size"><Vector3>6, 1, 6</Vector3></Property><Property name="BrickColor"><int>23</int></Property><Property name="Neutral"><bool>true</bool></Property></Properties></Item></Item><Item class_name="Lighting" referent="RBXC1C092C7ECE0"><Properties><Property name="Name"><string>Lighting</string></Property><Property name="Brightness"><float>1</float></Property><Property name="ClockTime"><float>0.5</float></Property><Property name="FogEnd"><float>190</float></Property><Property name="FogStart"><float>10</float></Property><Property name="FogColor"><Color3>0.035, 0.045, 0.07</Color3></Property><Property name="Ambient"><Color3>0.04, 0.04, 0.07</Color3></Property><Property name="OutdoorAmbient"><Color3>0.02, 0.025, 0.04</Color3></Property></Properties></Item><Item class_name="ServerScriptService" referent="RBX5DFBBA032365"><Properties><Property name="Name"><string>ServerScriptService</string></Property></Properties><Item class_name="Script" referent="RBX40ED794D82D5"><Properties><Property name="Name"><string>HorrorGameServer</string></Property></Properties><Properties><Property name="Source"><ProtectedString>local Players=game:GetService("Players")
local Lighting=game:GetService("Lighting")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local event=Instance.new("RemoteEvent"); event.Name="HorrorEvent"; event.Parent=ReplicatedStorage
local objectives={"تحقق من اختفاء الشرطي","خذ معدات الحماية من صندوق السيارة","صوّر سيارة الشرطي","صوّر جثة الشرطي","اجمع المفاتيح الستة وافتح الأقفال","حل لغز المفتاح الأبيض وواجه الكيانات"}
local collected,opened,progress={},{},{}
local function say(p,msg,obj) event:FireClient(p,"message",msg,obj) end
local function prompt(part,action,obj,fn)
 local pr=Instance.new("ProximityPrompt"); pr.ActionText=action; pr.ObjectText=obj
 pr.HoldDuration=.7; pr.MaxActivationDistance=10; pr.RequiresLineOfSight=false; pr.Parent=part
 pr.Triggered:Connect(fn)
end
Players.PlayerAdded:Connect(function(p)
 collected[p]={}; opened[p]={}; progress[p]=0
 p.CharacterAdded:Connect(function()
  task.wait(2); say(p,"مهمتك: توجه إلى الحارة المسكونة وابحث عن الشرطي المفقود.",objectives[1])
  task.wait(6); say(p,"المدير: في شرطي مختفي من يومين وانقطع اتصاله بعد إرساله للحارة المسكونة. الحكومة تثق بك. اذهب وتحقق من الوضع.",objectives[2])
  task.wait(7); say(p,"أنت: تمام سيدي، أمرك. سأذهب الآن.",objectives[2])
 end)
end)
Players.PlayerRemoving:Connect(function(p) collected[p]=nil; opened[p]=nil; progress[p]=nil end)
local trunk=Instance.new("Part"); trunk.Name="TrunkEquipment"; trunk.Size=Vector3.new(5,1,3); trunk.Position=Vector3.new(0,1,-198)
trunk.Anchored=true; trunk.Material=Enum.Material.Metal; trunk.Color=Color3.fromRGB(35,35,40); trunk.Parent=workspace
prompt(trunk,"افتح","صندوق معدات الشرطة",function(p)
 collected[p].equipment=true; say(p,"أخذت المصباح والمسدس والهاتف. استخدم الهاتف لتوثيق الأدلة.",objectives[3])
end)
for _,name in ipairs({"CrashedPoliceCar","OfficerBody"}) do
 local obj=workspace:FindFirstChild(name)
 if obj then prompt(obj,"صوّر الدليل",name=="OfficerBody" and "جثة الشرطي" or "سيارة الشرطي",function(p)
  collected[p][name]=true
  if collected[p].CrashedPoliceCar and collected[p].OfficerBody then say(p,"تم توثيق الدليلين. ابحث عن المفاتيح الستة.",objectives[4])
  else say(p,"تم حفظ الصورة. بقي دليل آخر.",objectives[3]) end
 end) end
end
for i=1,6 do
 local key=workspace:FindFirstChild("KeySpawn_"..i); local door=workspace:FindFirstChild("LockDoor_"..i)
 if key and door then
  prompt(key,"التقط المفتاح","مفتاح "..i,function(p)
   if not (collected[p].CrashedPoliceCar and collected[p].OfficerBody) then say(p,"وثّق الدليلين أولاً."); return end
   collected[p]["key"..i]=true; key.Transparency=1; key.CanCollide=false
   say(p,"حصلت على المفتاح "..i..". ابحث عن القفل المطابق.",objectives[5])
  end)
  prompt(door,"افتح القفل","القفل "..i,function(p)
   if not collected[p]["key"..i] then say(p,"تحتاج المفتاح المطابق."); return end
   if opened[p][i] then return end
   opened[p][i]=true; door.Transparency=.75; door.CanCollide=false
   if i==6 then say(p,"المفتاح الأبيض! لغز الرموز: أزرق، أحمر، بنفسجي، أبيض.","لغز المفتاح الأبيض")
   else say(p,"انفتح القفل "..i..". تسمع خطوات تقترب منك...",objectives[5]) end
  end)
 end
end
local order={2,1,3,4}
for i=1,4 do
 local rune=workspace:FindFirstChild("PuzzleRune_"..i)
 if rune then prompt(rune,"فعّل الرمز","لغز الرموز",function(p)
  progress[p]=progress[p] or 0
  if i==order[progress[p]+1] then
   progress[p]+=1; say(p,"صحيح "..progress[p].."/4")
   if progress[p]==4 then
    say(p,"اكتمل اللغز! إنذار أحمر! دافع عن نفسك من الكيانات.")
    Lighting.FogEnd=90
    for n=1,30 do task.delay(n*3,function()
     local ghost=Instance.new("Part"); ghost.Name="HauntingEntity"; ghost.Shape=Enum.PartType.Ball
     ghost.Size=Vector3.new(4,6,4); ghost.Material=Enum.Material.Neon
     ghost.Color=Color3.fromRGB(100,0,120); ghost.Anchored=false
     ghost.Position=Vector3.new(math.random(-20,20),5,math.random(15,150)); ghost.Parent=workspace
     local hum=Instance.new("Humanoid"); hum.MaxHealth=40; hum.Health=40; hum.Parent=ghost
     local light=Instance.new("PointLight",ghost); light.Color=ghost.Color; light.Range=12
    end) end
   end
  else progress[p]=0; say(p,"خطأ! الترتيب غير صحيح. أعد المحاولة.") end
 end) end
end
</ProtectedString></Property></Properties></Item></Item><Item class_name="StarterPlayer" referent="RBXE767A455E458"><Properties><Property name="Name"><string>StarterPlayer</string></Property></Properties><Item class_name="StarterPlayerScripts" referent="RBX24ACFD7B3DCC"><Properties><Property name="Name"><string>StarterPlayerScripts</string></Property></Properties><Item class_name="LocalScript" referent="RBX29FC4BD3F677"><Properties><Property name="Name"><string>HorrorHUD</string></Property></Properties><Properties><Property name="Source"><ProtectedString>local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local player=Players.LocalPlayer
local event=ReplicatedStorage:WaitForChild("HorrorEvent")
local gui=Instance.new("ScreenGui"); gui.Name="HorrorHUD"; gui.ResetOnSpawn=false; gui.Parent=player:WaitForChild("PlayerGui")
local panel=Instance.new("Frame",gui); panel.Size=UDim2.new(.62,0,.18,0); panel.Position=UDim2.new(.19,0,.77,0)
panel.BackgroundColor3=Color3.fromRGB(8,8,12); panel.BackgroundTransparency=.15
local corner=Instance.new("UICorner",panel); corner.CornerRadius=UDim.new(0,12)
local title=Instance.new("TextLabel",panel); title.Size=UDim2.new(1,-20,.28,0); title.Position=UDim2.new(0,10,0,5)
title.BackgroundTransparency=1; title.Text="THE HAUNTED DISTRICT"; title.TextColor3=Color3.fromRGB(180,20,30)
title.Font=Enum.Font.GothamBold; title.TextScaled=true
local body=Instance.new("TextLabel",panel); body.Size=UDim2.new(1,-24,.62,0); body.Position=UDim2.new(0,12,.32,0)
body.BackgroundTransparency=1; body.TextColor3=Color3.new(1,1,1); body.Font=Enum.Font.Gotham
body.TextWrapped=true; body.TextScaled=true; body.Text="استكشف الحارة بحذر..."
event.OnClientEvent:Connect(function(kind,msg,obj)
 if kind=="message" then
  body.Text=tostring(msg)..(obj and ("\nالمهمة: "..obj) or "")
  panel.Visible=true; task.delay(9,function() if panel.Parent then panel.Visible=false end end)
 end
end)
local fade=Instance.new("Frame",gui); fade.Size=UDim2.fromScale(1,1); fade.BackgroundColor3=Color3.new(0,0,0)
fade.BackgroundTransparency=0; TweenService:Create(fade,TweenInfo.new(5),{BackgroundTransparency=1}):Play()
</ProtectedString></Property></Properties></Item></Item></Item></Item></roblox>